# Base URL of the Neviri backend.
# Required by /blogs (calls /api/v1/blog/public) and /support (calls /api/v1/support/send-email).
NEXT_PUBLIC_API_URL=https://console.neviri.com

# App (dashboard) base URL the Login / Sign-up buttons point to.
# Set per environment so staging/local don't redirect to production:
#   local:   http://localhost:3000
#   staging: https://staging.neviri.com
#   prod:    https://sng-central.neviri.com
NEXT_PUBLIC_APP_URL=https://sng-central.neviri.com

# Cloudflare Turnstile site key for the CAPTCHA on the /support form.
# Create it at Cloudflare dashboard -> Turnstile (the site is already on
# Cloudflare). When unset, the component falls back to Cloudflare's
# always-passes TEST key so the widget still renders in dev/preview.
# NOTE: the token the widget produces MUST be verified server-side by the
# backend /api/v1/support/send-email endpoint (Cloudflare siteverify + the
# SECRET key) — a client-only CAPTCHA is bypassable.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Base URL of the Neviri backend.
# Required by /blogs (calls /api/v1/blog/public) and /support (calls /api/v1/support/send-email).
NEXT_PUBLIC_API_URL=https://console.neviri.com

# App (dashboard) base URL the Login / Sign-up buttons point to.
# Set per environment so staging/local don't redirect to production:
#   local:   http://localhost:3000
#   staging: https://staging.neviri.com
#   prod:    https://sng-central.neviri.com
NEXT_PUBLIC_APP_URL=https://sng-central.neviri.com
